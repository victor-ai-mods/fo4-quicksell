{
    "modName": "QuickSell",
    "displayName": "Quick Sell",
    "author": "Victor",
    "minMcmVersion": 1,
    "pluginRequirements": [
        "QuickSell.esp"
    ],
    "content": [
        { "type": "section", "text": "Quick Sell" },
        {
            "id": "SellModeActive",
            "text": "Sell Mode: enabled",
            "type": "switcher",
            "help": "While enabled, items moved between the player's inventory and any open container are tracked, and closing the container shows a sell confirmation dialog.",
            "valueOptions": {
                "sourceType": "PropertyValueBool",
                "sourceForm": "QuickSell.esp|F99",
                "propertyName": "SellModeActive"
            }
        },
        {
            "id": "SellPercent",
            "text": "Sell price, % of vendor price",
            "type": "slider",
            "help": "Percentage of the price a real vendor would actually pay for the item (based on your Charisma and Cap Collector perk, capped like normal barter) - not the item's raw base value.",
            "valueOptions": {
                "min": 10,
                "max": 100,
                "step": 5,
                "sourceType": "PropertyValueInt",
                "sourceForm": "QuickSell.esp|F99",
                "propertyName": "SellPercent"
            }
        },
        { "type": "spacer" },
        {
            "id": "GrantAllAidItems",
            "text": "[ Add mod management items to Aid ]",
            "type": "button",
            "help": "Adds the QuickSell Configurator to your Aid inventory, along with the Sell Mode Switch and Mobile Barter Beacon if you'd already unlocked them - in case any were lost, sold, or scrapped.",
            "action": {
                "type": "CallFunction",
                "form": "QuickSell.esp|F99",
                "scriptName": "QS_SellModeControllerScript",
                "function": "GrantAllAidItems",
                "params": []
            }
        },
        { "type": "spacer" },
        { "type": "section", "text": "Hotkeys" },
        {
            "id": "SellModeToggleHotkey",
            "text": "Toggle Sell Mode",
            "type": "hotkey",
            "help": "Global hotkey: toggles Sell Mode on/off at any time, without opening MCM.",
            "valueOptions": {
                "allowModifierKeys": true
            }
        },
        {
            "id": "OpenBarterHotkey",
            "text": "Open Mobile Barter",
            "type": "hotkey",
            "help": "Global hotkey: opens Mobile Barter directly.",
            "valueOptions": {
                "allowModifierKeys": true
            }
        }
    ]
}
